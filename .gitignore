# Internal documentation and working files. Netlify publishes the repo root,
# so anything committed here becomes publicly reachable on simonflatin.com.
MEMORY/

# Generated language variants. Netlify runs `node build.js` on deploy, so these
# are rebuilt from content/ and projects/ and do not belong in the repo.
/no/
/pt/

# Original photography, 535 MB. The site serves the optimised derivatives in
# */web/ instead, which ARE tracked. The originals stay in Google Drive and
# remain in git history at commit fbf397f, recoverable with:
#   git checkout fbf397f -- projects/ content/
# These patterns deliberately do not match */web/*.webp.
projects/*/*.jpg
projects/*/*.jpeg
projects/*/*.png
content/*/*.jpg
content/*/*.jpeg
content/*/*.png
/Simon Flatin 2024_4.jpg

